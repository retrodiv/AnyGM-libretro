GML_RENDER_GPU_OPERATION(TEXTURED_QUAD, supported, gml_render_gpu_opengl_draw_textured_quad, "Qualified placed affine surface points and resident sprite, background (including native filtered tiny-opacity selected presets with qualified raw-alpha cutoff and first-generation axis cutout for fixed presets), tile, glyph (including native placed modern nearest rotations with byte cutout and draw alpha down to 1/256), positioned and integer surface-part/stretched quad rules, including source-colour/source-alpha packaged and runtime axis sprites and whole surfaces, plus bounded filtered surface cutoffs and ordered generic source-over point and box overlaps with signed source axes and qualified presets, including distinct owned and registered borrowed Studio application sources, positive full-source two-axis and mixed-axis reductions and ordinary, Classic aspect and filtered Classic application two-axis magnification (including normal blend-disabled and zero alpha-test reference) including repeats with target-sized axes and the bounded normal blend-disabled overlap, captured independent-factor ordinary whole-source nearest/box surfaces and positive-axis runtime sprites and qualified nearest axis packaged sprites and nearest real/sprite-font glyphs; unqualified variants use ordered CPU fallback")
GML_RENDER_GPU_OPERATION(TEXTURED_TRIANGLES, fallback, gml_render_cpu_blit_sprite_pos_resolved, "Dedicated opcode unselected; qualified positioned and corner-colour geometry uses TEXTURED_QUAD; unqualified positioned geometry keeps ordered CPU triangles")
GML_RENDER_GPU_OPERATION(COLOURED_PRIMITIVE, supported, gml_render_gpu_opengl_draw_primitive, "Qualified opaque flat, span, line, outline and particle-square regions, independent point lists with zero and bounded positive alpha including qualified texture sampling, source-colour/source-alpha primitive rectangles and captured independent-factor filled, outlined and gradient rectangles with separate equations/masks, plus ordinary SCREEN/application/numbered source-over and selected-view normal/additive native triangles; unqualified variants use ordered CPU fallback")
GML_RENDER_GPU_OPERATION(CLEAR, supported, gml_render_gpu_opengl_clear, "P3 resident target region clear with explicit preflight")
GML_RENDER_GPU_OPERATION(CLEAR_DEPTH, supported, gml_gpu_opengl_scene_clear_depth, "Depth-only device service preserves colour versions and clears a target-local attachment")
GML_RENDER_GPU_OPERATION(COPY_IMAGE, supported, gml_render_gpu_opengl_copy_image, "Bounded public raw copies use exact device blits with whole-source alias snapshots and logical row pitches; unavailable resource/history states retain the original ordered CPU kernels")
GML_RENDER_GPU_OPERATION(COMPOSE_SURFACE, fallback, gml_render_cpu_draw_surface_stretched_impl, "Unqualified surface composition retains ordered CPU kernels; qualified opaque/binary integer part and stretched draws use TEXTURED_QUAD, and qualified content programs use CONTENT_SHADER_DRAW")
GML_RENDER_GPU_OPERATION(LAYER_EFFECT, supported, gml_render_gpu_opengl_apply_effect, "P7 bounded resident captured tint, colourise, zoom blur, bounded six-axis large blur, ordered private glow and two-source clouds, boxes and underwater share device clear/copy, ordinary raster ports and retained source ownership on matching SCREEN, application or numbered targets; sampled effects bind a versioned raw runtime or atlas sampler with native logical trim/repeat/filter preparation, palette reads and displaced capture filtering; zero-source in-place tint and RGB noise share immutable target snapshots; unsupported capture/draw states and excluded effect families retain counted CPU boundaries")
GML_RENDER_GPU_OPERATION(PRESENT_IMAGE, fallback, gml_render_cpu_present_image, "Neutral scene opcode unselected; qualified terminal resident-source presentation, including scaled resident SCREEN crops, uses the existing plan; CRT and plain host crops from the completed-device cache share its samplers; other presentation retains coherent CPU materialization")
GML_RENDER_GPU_OPERATION(CONTENT_SHADER_DRAW, supported, gml_gpu_opengl_scene_shader_draw, "Qualified public full-target surface programs with per-draw state/samplers and distinct-target multipass; excluded program/target variants retain the established ordered fallback")
GML_RENDER_GPU_OPERATION(SOFTWARE3D_PASS, supported, gml_render_gpu_opengl_depth_triangle, "Qualified source-free and texture-bound active fixed-function triangles and bounded point/line producers share projection and clipping, device repeat/filter sampling, prepared lighting/fog and the measured fixed-function alpha-test policy, the existing normal/replacement policy plus captured pixel presets and independent factors/equations/masks, including per-command opaque-alpha stamping or candidate-only opaque alpha input and joint colour/raw-depth publication, plus ordered normal-blend point pairs with exact repeat sampling from qualified texture sources and captured per-endpoint lighting and fog for float-coincident projected lines; actual depth and deferred texture bytes import before counted CPU fallback; unqualified point/line variants, aliases, unsupported local views, programs and other state remain debt")
GML_RENDER_GPU_OPERATION(RECOVER_EMPTY_SCREEN, supported, gml_gpu_opengl_scene_reduce_rgb, "Qualified empty-screen application recovery keeps its exact RGB predicate and conditional point blit on the device; excluded variants retain the existing query and CPU fallback")
