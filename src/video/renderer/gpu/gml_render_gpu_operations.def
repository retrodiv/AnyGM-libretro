GML_RENDER_GPU_OPERATION(CLEAR, supported, gml_render_gpu_opengl_clear, "P3 resident target region clear with explicit preflight")
GML_RENDER_GPU_OPERATION(COPY_IMAGE, planned, gml_render_gpu_opengl_copy_image, "P3+ versioned image copy")
GML_RENDER_GPU_OPERATION(COMPOSE_SURFACE, planned, gml_render_gpu_opengl_compose_surface, "P3+ versioned surface composition")
GML_RENDER_GPU_OPERATION(LAYER_EFFECT, planned, gml_render_gpu_opengl_apply_effect, "P7 qualified effect families or bounded CPU fallback")
GML_RENDER_GPU_OPERATION(PRESENT_IMAGE, planned, gml_render_gpu_opengl_present_image, "P3+ resident presentation")
GML_RENDER_GPU_OPERATION(CONTENT_SHADER_DRAW, planned, gml_render_gpu_opengl_content_shader_draw, "P7 resident content-program pass or existing host handoff")
GML_RENDER_GPU_OPERATION(SOFTWARE3D_PASS, fallback, gml_d3_draw_sprite_2d, "conservative software-3D bridge with CPU/GPU barrier")
