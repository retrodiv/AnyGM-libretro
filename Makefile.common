# The optional hardware backend and its libretro bridge are one source-list switch, so removing the
# feature is a deletion of bounded modules rather than a reversal of the renderer architecture.
ifeq ($(HARDWARE_RENDER),0)
ANYGM_GPU_SOURCES :=
ANYGM_LIBRETRO_HARDWARE_SOURCES :=
else
ANYGM_GPU_SOURCES := \
	src/video/gpu/gml_gpu.c \
	src/video/gpu/gml_gpu_gl.c
ANYGM_LIBRETRO_HARDWARE_SOURCES := \
	src/adapters/libretro/libretro_hw_render.c
endif

ifeq ($(DIAGNOSTICS),1)
ANYGM_DIAGNOSTIC_SOURCES := \
	src/runtime/vm/gml_vm_diagnostics.c
else
ANYGM_DIAGNOSTIC_SOURCES :=
endif

ANYGM_VM_SOURCES := \
	src/runtime/vm/gml_value.c \
